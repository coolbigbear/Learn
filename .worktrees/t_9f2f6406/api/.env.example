# Interactive Python Tutorials — Backend Configuration
# Copy to .env and adjust as needed.

# Database URL
# Default: SQLite in the api/ directory
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/tutorials
# DATABASE_URL=sqlite+aiosqlite:///./tutorials.db

# CORS allowed origins (comma-separated)
# Default: Vite dev server on localhost:5173
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sandbox limits
# MAX_CPU_SECONDS=2
# MAX_MEMORY_MB=128
# MAX_OUTPUT_CHARS=10000
# WALL_CLOCK_TIMEOUT=3.0
# SHELL_TIMEOUT=5.0